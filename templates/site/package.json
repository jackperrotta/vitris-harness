{
  "name": "__SLUG__",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./node_modules/@tryvitris/website-harness/bin/vitris-build.js --site . --out dist --slug __SLUG__",
    "harvest": "node ./node_modules/@tryvitris/website-harness/bin/vitris-harvest.js",
    "media:prepare": "node ./node_modules/@tryvitris/website-harness/bin/vitris-prepare-media.js --site .",
    "media:register": "node ./node_modules/@tryvitris/website-harness/bin/vitris-prepare-media.js --site . --register",
    "media:serve": "node ./node_modules/@tryvitris/website-harness/bin/vitris-media-serve.js --site .",
    "eval": "node ./node_modules/@tryvitris/website-harness/bin/vitris-eval.js",
    "go": "node ./node_modules/@tryvitris/website-harness/bin/vitris-go.js",
    "preflight": "node ./node_modules/@tryvitris/website-harness/bin/vitris-launch-preflight.js --environment production",
    "deploy": "node ./node_modules/@tryvitris/website-harness/bin/vitris.js deploy --site . --environment production",
    "deploy:preview": "node ./node_modules/@tryvitris/website-harness/bin/vitris.js deploy --site . --environment preview",
    "deploy:quick": "node ./node_modules/@tryvitris/website-harness/bin/vitris.js deploy --site . --environment production --quick",
    "verify:browser": "node ./node_modules/@tryvitris/website-harness/bin/vitris-verify-browser.js",
    "verify:performance": "node ./node_modules/@tryvitris/website-harness/bin/vitris-verify-performance.js --site .",
    "refresh-agent": "node ./node_modules/@tryvitris/website-harness/bin/vitris-refresh.js --site .",
    "preview": "node ./node_modules/@tryvitris/website-harness/bin/vitris-preview.js"
  },
  "dependencies": {
    "@tryvitris/website-harness": "__HARNESS__"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
