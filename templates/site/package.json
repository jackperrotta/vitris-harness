{
  "name": "__SLUG__",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./node_modules/@vitris/harness/bin/vitris-build.js --site . --out dist --slug __SLUG__",
    "harvest": "node ./node_modules/@vitris/harness/bin/vitris-harvest.js",
    "media:prepare": "node ./node_modules/@vitris/harness/bin/vitris-prepare-media.js --site .",
    "media:register": "node ./node_modules/@vitris/harness/bin/vitris-prepare-media.js --site . --register",
    "media:serve": "node ./node_modules/@vitris/harness/bin/vitris-media-serve.js --site .",
    "eval": "node ./node_modules/@vitris/harness/bin/vitris-eval.js",
    "go": "node ./node_modules/@vitris/harness/bin/vitris-go.js",
    "preflight": "node ./node_modules/@vitris/harness/bin/vitris-launch-preflight.js --environment production",
    "deploy": "npm run build && npm run preflight && wrangler pages deploy dist --project-name=__SLUG__",
    "verify:browser": "node ./node_modules/@vitris/harness/bin/vitris-verify-browser.js",
    "refresh-agent": "node ./node_modules/@vitris/harness/bin/vitris-refresh.js --site .",
    "preview": "node ./node_modules/@vitris/harness/bin/vitris-preview.js"
  },
  "dependencies": {
    "@vitris/harness": "__HARNESS__"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=24"
  }
}
