name: Deploy (optional GitHub Actions)
# Local builds and direct uploads are the default: use npm run deploy locally.
# This example does not run from deployment/. To opt into hosted CI, copy it to
# .github/workflows/deploy.yml and configure your own protected secrets.
# Enable only one automatic deployment path for each site.
on:
  push:
    branches: [main]
  pull_request:
jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      VITRIS_TENANT_ID: ${{ secrets.VITRIS_TENANT_ID }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
      - run: npm ci
      - run: npx playwright install --with-deps chromium
      - run: npm run build
        env:
          VITRIS_BACKEND_ORIGIN: ${{ secrets.VITRIS_BACKEND_ORIGIN || secrets.KERNEL_ORIGIN }}
          VITRIS_SITE_ENVIRONMENT: ${{ github.ref == 'refs/heads/main' && 'production' || 'preview' }}
      - name: Launch preflight
        run: |
          if [ "${{ github.ref }}" = "refs/heads/main" ]; then
            node ./node_modules/@tryvitris/website-harness/bin/vitris-launch-preflight.js --environment production --site .
          else
            node ./node_modules/@tryvitris/website-harness/bin/vitris-launch-preflight.js --environment preview --site .
          fi
      - name: Deploy to Cloudflare Pages
        if: github.ref != 'refs/heads/main' || env.VITRIS_TENANT_ID == ''
        # On PRs / non-main, --branch creates a Pages preview deployment.
        run: |
          BRANCH="${{ github.head_ref || github.ref_name }}"
          if [ "${{ github.ref }}" = "refs/heads/main" ]; then
            npx wrangler pages deploy dist --project-name=__SLUG__
          else
            npx wrangler pages deploy dist --project-name=__SLUG__ --branch="$BRANCH"
          fi
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
      - name: Publish authenticated exact bundle through the backend Worker
        if: github.ref == 'refs/heads/main' && env.VITRIS_TENANT_ID != ''
        env:
          VITRIS_PUBLISH_ATTESTATION_SECRET: ${{ secrets.VITRIS_PUBLISH_ATTESTATION_SECRET }}
          VITRIS_BACKEND_ORIGIN: ${{ secrets.VITRIS_BACKEND_ORIGIN || secrets.KERNEL_ORIGIN }}
        run: |
          node ./node_modules/@tryvitris/website-harness/bin/vitris-sign-publish-bundle.js \
            --site . --tenant-id "$VITRIS_TENANT_ID" --slug __SLUG__ --project __SLUG__ \
            --out "$RUNNER_TEMP/vitris-publish-bundle.json"
          curl --fail-with-body --silent --show-error \
            -H 'content-type: application/json' \
            --data-binary @"$RUNNER_TEMP/vitris-publish-bundle.json" \
            "${VITRIS_BACKEND_ORIGIN%/}/api/publish-attested"
