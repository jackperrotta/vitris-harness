{
  "name": "@vitris/harness",
  "version": "0.1.0-beta.3",
  "description": "Vitris agent harness for building and verifying customer websites, with a static compiler, media tools, and optional Cloudflare backend.",
  "type": "module",
  "exports": {
    "./icons": {
      "types": "./bin/types/src/icons/index.d.ts",
      "import": "./bin/api/icons.js"
    },
    ".": {
      "types": "./bin/types/src/build/index.d.ts",
      "import": "./bin/api/index.js"
    },
    "./render": {
      "types": "./bin/types/src/render.d.ts",
      "import": "./bin/api/render.js"
    },
    "./theme": {
      "types": "./bin/types/src/theme.d.ts",
      "import": "./bin/api/theme.js"
    },
    "./schema": {
      "types": "./bin/types/src/schema.d.ts",
      "import": "./bin/api/schema.js"
    },
    "./types": {
      "types": "./bin/types/src/types.d.ts",
      "import": "./bin/api/types.js"
    },
    "./agent/graph": {
      "types": "./bin/types/src/agent/graph.d.ts",
      "import": "./bin/api/agent/graph.js"
    },
    "./agent/grade": {
      "types": "./bin/types/src/agent/grade.d.ts",
      "import": "./bin/api/agent/grade.js"
    },
    "./agent/artifacts": {
      "types": "./bin/types/src/agent/artifacts.d.ts",
      "import": "./bin/api/agent/artifacts.js"
    },
    "./agent/evaluate": {
      "types": "./bin/types/src/agent/evaluate.d.ts",
      "import": "./bin/api/agent/evaluate.js"
    },
    "./cli": {
      "types": "./bin/types/src/cli/index.d.ts",
      "import": "./bin/api/cli.js"
    },
    "./cli/api": {
      "types": "./bin/types/src/cli/api.d.ts",
      "import": "./bin/api/cli/api.js"
    },
    "./contracts": {
      "types": "./bin/types/src/engine/contracts.d.ts",
      "import": "./bin/api/contracts.js"
    },
    "./engine": {
      "types": "./bin/types/src/engine/index.d.ts",
      "import": "./bin/api/engine.js"
    },
    "./hosting": {
      "types": "./bin/types/src/integrations/hosting.d.ts",
      "import": "./bin/api/hosting.js"
    },
    "./references": {
      "types": "./bin/types/src/agent/reference-library.d.ts",
      "import": "./bin/api/references.js"
    }
  },
  "bin": {
    "vitris": "bin/vitris.js",
    "vitris-build": "bin/vitris-build.js",
    "vitris-catalog": "bin/vitris-catalog.js",
    "vitris-create-site": "bin/vitris-create-site.js",
    "vitris-harvest": "bin/vitris-harvest.js",
    "vitris-prepare-media": "bin/vitris-prepare-media.js",
    "vitris-eval": "bin/vitris-eval.js",
    "vitris-go": "bin/vitris-go.js",
    "vitris-launch-preflight": "bin/vitris-launch-preflight.js",
    "vitris-knowledge": "bin/vitris-knowledge.js",
    "vitris-blocks": "bin/vitris-blocks.js",
    "vitris-sign-publish-bundle": "bin/vitris-sign-publish-bundle.js",
    "vitris-preview": "bin/vitris-preview.js",
    "vitris-refresh": "bin/vitris-refresh.js",
    "vitris-verify-browser": "bin/vitris-verify-browser.js",
    "vitris-migrate-site": "bin/vitris-migrate-site.js",
    "vitris-stock": "bin/vitris-stock.js",
    "vitris-upgrade": "bin/vitris-upgrade.js",
    "vitris-references": "bin/vitris-references.js",
    "vitris-art": "bin/vitris-art.js",
    "vitris-content-coverage": "bin/vitris-content-coverage.js",
    "vitris-themes": "bin/vitris-themes.js",
    "vitris-templates": "bin/vitris-templates.js",
    "vitris-motion-view": "bin/vitris-motion-view.js",
    "vitris-media-serve": "bin/vitris-media-serve.js",
    "vitris-cursor-hook": "bin/vitris-cursor-hook.js",
    "vitris-icons": "bin/vitris-icons.js"
  },
  "files": [
    "bin/**/*.js",
    "bin/types/**/*.d.ts",
    "templates/site",
    "agent",
    "blocks",
    "design-system/MASTER.md",
    "design-system/knowledge",
    "docs/CLI.md",
    "docs/DISTRIBUTION.md",
    "docs/ENGINE.md",
    "docs/CLOUDFLARE.md",
    "docs/CONTACT-FORMS.md",
    "docs/PRESERVE.md",
    "docs/STOCK-MEDIA.md",
    "docs/SECURITY.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "src/runtime",
    "cloudflare",
    "migrations/*.sql",
    "design-system/calibration/v2",
    "licenses",
    "src/stock/*.json",
    "src/stock/*.css",
    "src/stock/*.js",
    "bin/cloudflare/*.wasm",
    "design-system/compositions/v1",
    "design-system/compositions/v2",
    "design-system/references"
  ],
  "scripts": {
    "build:cli": "node scripts/build-package.mjs",
    "test:preserve": "node --experimental-strip-types --test --test-concurrency=1 src/preserve.test.ts src/preserve-batch.test.ts",
    "prepack": "npm run build:cli && npm run audit:package",
    "catalog": "node --experimental-strip-types scripts/catalog.ts",
    "stock": "node --experimental-strip-types scripts/stock-library.ts",
    "build:demo": "node --experimental-strip-types src/build/cli.ts --site src/test/fixtures/site --out dist/demo --slug demo",
    "create-site": "node --experimental-strip-types scripts/create-site.ts",
    "harvest": "node --experimental-strip-types scripts/harvest.ts",
    "eval-refine": "node --experimental-strip-types scripts/eval-refine.ts",
    "go": "node --experimental-strip-types scripts/workflow.ts",
    "blocks:index": "node --experimental-strip-types scripts/write-blocks-index.ts",
    "blocks:preview": "node --experimental-strip-types scripts/blocks-preview.ts",
    "blocks:serve": "node --experimental-strip-types scripts/blocks-preview.ts --serve",
    "dev": "npm run catalog && wrangler d1 migrations apply vitris --local --persist-to .wrangler/state && wrangler dev --local --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply vitris --local --persist-to .wrangler/state",
    "db:seed": "wrangler d1 execute vitris --local --persist-to .wrangler/state --file=migrations/0002_seed.sql",
    "deploy": "wrangler deploy",
    "preview:prepare": "node scripts/prepare-worker-preview.mjs",
    "preview:worker": "wrangler preview --config .wrangler-preview.jsonc --ignore-base-config",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=4 src/icons.test.ts src/template-icon-migration.test.ts src/engine.test.ts src/upgrade.test.ts src/hosting.test.ts src/render.test.ts src/analytics.test.ts src/cookie-compliance.test.ts src/schema.test.ts src/patch.test.ts src/jobs.test.ts src/onboard.test.ts src/github-preview.test.ts src/agent.test.ts src/blocks.test.ts src/workflow.test.ts src/design-run.test.ts src/creative-profile.test.ts src/creative-efficiency.test.ts src/refine.test.ts src/critic-calibration.test.ts src/cli.test.ts src/jev.test.ts src/lifecycle.test.ts src/theme-lifecycle-policy.test.ts src/template-adaptation.test.ts src/adaptation-checkpoint.test.ts src/template-motion.test.ts src/template-motion-browser.test.ts src/experience-browser.test.ts src/jev-capabilities.test.ts src/jev-phase8.test.ts src/jev-prepilot.test.ts src/jev-phase0.test.ts src/jev-sept20.test.ts src/trace.test.ts src/cursor-hook.test.ts src/design-intelligence.test.ts src/design-context-integration.test.ts src/package-bin.test.ts src/knowledge-layers.test.ts src/launch-preflight.test.ts src/worker-publish.test.ts src/worker-preview.test.ts src/harness-upgrades.test.ts src/stock-media.test.ts src/harness-distribution.test.ts src/storyboard-media.test.ts src/added-media.test.ts src/lead-forms.test.ts src/composition.test.ts src/reference-library.test.ts src/art-direction.test.ts src/scroll-motion.test.ts src/scroll-motion-browser.test.ts src/artistic-motion-browser.test.ts src/page-composition.test.ts src/reference-quality.test.ts src/production-quality.test.ts src/browser-focus.test.ts src/browser-work-queue.test.ts src/quality-subject.test.ts src/preview-cli.test.ts src/theme-selection.test.ts src/site-inputs.test.ts src/fieldwell.test.ts src/still-field.test.ts src/current-craft.test.ts src/copper-chair.test.ts src/clearline.test.ts src/template-cloud.test.ts src/contact-forms.test.ts src/contact-forms-operations.test.ts src/contact-forms-browser.test.ts src/preserve.test.ts src/release-safety.test.ts",
    "eval:jev": "node --experimental-strip-types scripts/eval-jev.ts",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "refresh-agent": "node --experimental-strip-types scripts/refresh-agent.ts",
    "verify:browser": "node --experimental-strip-types scripts/verify-browser.ts",
    "compare-sites": "node --experimental-strip-types scripts/compare-sites.ts",
    "design-review": "node --experimental-strip-types scripts/design-review.ts",
    "design-mcp": "node --experimental-strip-types scripts/design-mcp.ts",
    "trial": "node --experimental-strip-types scripts/trial.ts",
    "preview": "node --experimental-strip-types scripts/preview.ts",
    "render:studies": "node --experimental-strip-types scripts/render-studies.ts",
    "verify:package": "npm run build:cli && node --experimental-strip-types scripts/verify-package.ts",
    "test:freeze": "node --experimental-strip-types scripts/freeze-test-baseline.ts",
    "pretest": "node scripts/prepare-test-fixtures.mjs && npm run build:cli",
    "stock:library": "node --experimental-strip-types scripts/stock-library.ts",
    "stock:inspect": "python scripts/inspect-stock.py",
    "references": "node --experimental-strip-types scripts/reference-library.ts",
    "themes": "node --experimental-strip-types scripts/theme-selection.ts",
    "templates": "node --experimental-strip-types scripts/templates.ts",
    "templates:gallery": "node --experimental-strip-types scripts/template-gallery.ts",
    "templates:artifact": "node --experimental-strip-types scripts/template-cloud-artifact.ts",
    "audit:package": "node scripts/audit-package.mjs",
    "prepublishOnly": "node scripts/guard-publish.mjs",
    "icons": "node --experimental-strip-types scripts/icons.ts",
    "icons:artifact": "node --experimental-strip-types scripts/icons.ts gallery",
    "icons:gallery": "node --experimental-strip-types scripts/icons.ts gallery --serve",
    "test:icons": "node --experimental-strip-types --test src/icons.test.ts",
    "verify:icons": "node --experimental-strip-types scripts/verify-icons.ts",
    "icons:review-industry-studio": "node --experimental-strip-types scripts/review-industry-studio.ts",
    "templates:icons": "node --experimental-strip-types scripts/migrate-template-icons.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.1",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "^5.9.2",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "blake3-wasm": "^2.1.5",
    "parse5": "8.0.0",
    "playwright": "^1.63.0"
  },
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackperrotta/vitris-harness.git"
  },
  "homepage": "https://github.com/jackperrotta/vitris-harness#readme",
  "bugs": {
    "url": "https://github.com/jackperrotta/vitris-harness/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
